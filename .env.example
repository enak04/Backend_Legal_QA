# ===========================================
# Application Backend Configuration
# ===========================================

# Legal_QA Service
LEGAL_QA_BASE_URL=http://localhost:8000
LEGAL_QA_TIMEOUT=120

# Database
DATABASE_URL=sqlite:///./conversations.db

# CORS (comma-separated origins, or * to allow all origins)
CORS_ORIGINS=*

# Server
APP_HOST=0.0.0.0
APP_PORT=8080

# OpenAI (Optional, enables dynamic smart intake)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Admin Panel & Auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_SECRET_KEY=legal-qa-admin-secret-key-change-in-production
ADMIN_SESSION_EXPIRY_HOURS=24
